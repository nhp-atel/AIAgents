# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Used by the evals/ series notebooks 05–08 (loaded via python-dotenv).

# Required for notebooks 05–08 (LLM-as-judge and traced/evaluated agents)
OPENAI_API_KEY=sk-...

# Required for notebooks 06–08 (LangSmith tracing, datasets, experiments)
# A free account at https://smith.langchain.com provides this key.
LANGCHAIN_API_KEY=lsv2_...
LANGSMITH_API_KEY=lsv2_...
LANGCHAIN_TRACING_V2=true
